# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data — runtime state and archived snapshots
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db.bak-*
data/workspaces/

# Frontend
web/node_modules/
web/dist/

# The Vite build output IS what the service serves: neither start.sh nor the
# systemd unit runs a build, so a clone without it has no UI. index.html also
# hard-references a content-hashed bundle name, so ignoring assets/ while
# tracking index.html would leave a fresh checkout pointing at a missing file.
# Sourcemaps are the exception — 1.4MB regenerated on every build, and the source
# they map is committed under web/src/ anyway.
static/assets/*.map

# Local env / secrets
.env
*.env
!.env.example
# The VAPID keypair for Web Push. The private key signs push messages and must never
# be committed; it is generated on first start and persisted here at mode 0600. The
# data/*.db* globs above do not cover a .json file, so it is named explicitly.
data/vapid.json

# TypeScript incremental build cache
web/tsconfig.tsbuildinfo
